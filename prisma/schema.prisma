datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Team {
  id                String           @id @default(uuid())
  name              String
  tag               String
  slug              String           @unique
  tier              String           @default("TIER 3") // TIER 1, TIER 2, TIER 3
  logoUrl           String
  description       String?
  frameStyle        String           @default("NONE") // NONE, GOLD, SILVER, COPPER, NEON, CRIMSON
  points            Int              @default(0)
  wins              Int              @default(0)
  losses            Int              @default(0)
  matchesPlayed     Int              @default(0)
  isDisqualified    Boolean          @default(false)
  disqualifiedUntil DateTime?
  disqualifyReason  String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  memberships  TeamMembership[]
  activityLogs ActivityLog[]
  matchesAsA   Match[]          @relation("TeamAMatches")
  matchesAsB   Match[]          @relation("TeamBMatches")
}

model Player {
  id                String           @id @default(uuid())
  nickname          String
  slug              String           @unique
  avatarUrl         String?
  defaultRole       String?          // Captain, AWPer, Rifler, IGL, Entry, Support, Coach
  steamUrl          String?
  faceitUrl         String?
  discordUrl        String?
  isDisqualified    Boolean          @default(false)
  disqualifiedUntil DateTime?
  disqualifyReason  String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  memberships TeamMembership[]
}

model TeamMembership {
  id        String    @id @default(uuid())
  teamId    String
  playerId  String
  role      String    // Captain, AWPer, Rifler, IGL, Entry, Support, Coach
  joinedAt  DateTime  @default(now())
  leftAt    DateTime?
  status    String    @default("ACTIVE") // ACTIVE or FORMER

  team      Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  player    Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@index([playerId])
}

model ActivityLog {
  id          String   @id @default(uuid())
  teamId      String?
  teamName    String?
  description String
  timestamp   DateTime @default(now())

  team        Team?    @relation(fields: [teamId], references: [id], onDelete: SetNull)
}

model Match {
  id          String    @id @default(uuid())
  teamAId     String
  teamBId     String
  scoreA      Int       @default(0)
  scoreB      Int       @default(0)
  status      String    @default("SCHEDULED") // SCHEDULED, LIVE, FINISHED, CANCELLED
  scheduledAt DateTime
  finishedAt  DateTime?
  bestOf      Int       @default(1) // 1 for BO1, 3 for BO3, 5 for BO5
  tier        String    @default("TIER 1")
  winnerId    String?
  isForfeit   Boolean   @default(false)
  forfeitReason String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  teamA       Team      @relation("TeamAMatches", fields: [teamAId], references: [id], onDelete: Cascade)
  teamB       Team      @relation("TeamBMatches", fields: [teamBId], references: [id], onDelete: Cascade)

  @@index([teamAId])
  @@index([teamBId])
}
